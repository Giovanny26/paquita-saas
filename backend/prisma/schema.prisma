generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  plan         Plan     @default(FREE)
  credits      Int      @default(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  avatar      Avatar?
  generations Generation[]
  jobs        Job[]
}

model Avatar {
  id        String   @id @default(cuid())
  userId    String   @unique
  imageUrl  String
  prompt    String
  options   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarRefs AvatarRef[]
}

model AvatarRef {
  id        String        @id @default(cuid())
  avatarId  String
  kind      AvatarRefKind
  imageUrl  String
  createdAt DateTime      @default(now())

  avatar Avatar @relation(fields: [avatarId], references: [id], onDelete: Cascade)

  @@index([avatarId, kind])
}

model Generation {
  id          String         @id @default(cuid())
  userId      String
  type        GenerationType
  prompt      String
  imageUrl    String?
  videoUrl    String?
  inputImages Json?
  isNsfw      Boolean        @default(false)
  creditsCost Int
  status      JobStatus      @default(PENDING)
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Job {
  id        String    @id @default(cuid())
  userId    String
  type      JobType
  status    JobStatus @default(PENDING)
  payload   Json
  result    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([type, status])
}

enum JobType {
  AVATAR_PACK
  GENERATION
}

enum Plan {
  FREE
  BASIC
  PRO
}

enum GenerationType {
  TEXT_TO_IMAGE
  IMAGE_TO_IMAGE
  IMAGE_TO_VIDEO
}

enum AvatarRefKind {
  PRIMARY
  FACE
  HALF_BODY
  FULL_BODY
  THREE_QUARTER
  PROFILE
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}